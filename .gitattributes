# Normalise line endings: LF in the repo and on checkout; Windows scripts stay CRLF.
* text=auto eol=lf

# Windows scripts need CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.pyd binary
*.so binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.mp3 binary
*.db binary
*.sqlite binary
*.xlsx binary
*.docx binary
*.pptx binary
